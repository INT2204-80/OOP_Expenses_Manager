@startuml Sequence_MergeCategories

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam maxMessageSize 58
skinparam sequence {
    ArrowColor #455A64
    LifeLineBorderColor #90A4AE
    LifeLineBackgroundColor #FAFAFA
    ParticipantBorderColor #607D8B
    ParticipantBackgroundColor #E3F2FD
    ActorBorderColor #E65100
    ActorBackgroundColor #FFF3E0
    GroupBackgroundColor #FAFAFA
    GroupBorderColor #B0BEC5
    ParticipantPadding 24
}

title Sequence - Gộp danh mục
autonumber

actor "Người dùng" as User
boundary "WalletView\nController" as Controller
control "WalletCategory\nManager" as Manager
control "CategoryService" as Service
participant "CategoryDAO" as DAO
database "MySQL" as DB

User -> Controller : Chọn danh mục và bấm "Gộp"
Controller -> Manager : handleMergeCategories(...)

alt Chọn ít hơn 2 danh mục
    Manager --> User : Cảnh báo cần chọn ít nhất 2
else Đã chọn từ 2 danh mục
    Manager --> User : Hiển thị ChoiceDialog chọn target
    User --> Manager : target category
    Manager -> Manager : sources = selected - target

    alt Có category khác TransactionType với target
        Manager --> User : Không thể gộp INCOME với EXPENSE
    else Tất cả cùng TransactionType
        Manager -> Service : mergeCategories(sources, target)
        Service -> DAO : mergeCategories(sources, target)

        DAO -> DB : SELECT targetId
        DB --> DAO : targetId

        group Một JDBC transaction cho các UPDATE
            DAO -> DB : BEGIN
            loop Mỗi source
                DAO -> DB : tìm sourceId
                DAO -> DB : UPDATE transactions → targetId
                DAO -> DB : UPDATE source category → is_deleted = TRUE
            end

            alt SQL thành công
                DAO -> DB : COMMIT
                DAO --> Service : success
                Service --> Manager : success
                Manager -> Service : getAllCategories()
                Service -> DAO : getAllCategories()
                DAO -> DB : SELECT active categories
                DB --> DAO : List<Category>
                DAO --> Service : List<Category>
                Service --> Manager : List<Category>
                Manager -> Controller : Làm mới danh sách và bộ lọc
                Controller --> User : Gộp danh mục thành công
            else SQLException
                DAO -> DB : ROLLBACK
                DAO --> Service : SQLException
                Service --> Manager : SQLException
                Manager --> User : Hiển thị thông báo lỗi
            end
        end
    end
end

note over DAO, DB
  Không xóa vật lý category nguồn.
  Các transaction được chuyển sang target trước khi source bị xóa mềm.
  Các lệnh UPDATE dùng chung transaction; lookup ID đi qua helper query.
end note

@enduml
