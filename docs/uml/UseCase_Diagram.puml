@startuml UseCase_Diagram
!pragma layout elk

skinparam backgroundColor #F8FAFC
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam roundCorner 14
skinparam PageMargin 36
skinparam nodesep 44
skinparam ranksep 54
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2
skinparam TitleFontColor #0F172A
skinparam TitleFontSize 20
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #0F766E
    FontColor #134E4A
    ArrowColor #475569
}
skinparam actor {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
    FontColor #9A3412
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #CBD5E1
    FontColor #1E293B
    RoundCorner 14
}
skinparam frame {
    BackgroundColor #FFFFFF
    BorderColor #CBD5E1
    FontColor #1E293B
}

title <b>OOP Expenses Manager · Use Cases</b>\n<size:12><color:#64748B>Năm nhóm mục tiêu chính của người dùng</color></size>
top to bottom direction

actor "Người dùng" as User

frame "OOP Expenses Manager" as SYSTEM #FFFFFF {
    usecase "Quản lý\nví" as WalletUC #F5F3FF
    usecase "Quản lý\ngiao dịch" as TransactionUC #FFF7ED
    usecase "Quản lý\ndanh mục" as CategoryUC #F0FDF4
    usecase "Quản lý\nngân sách" as BudgetUC #EFF6FF
    usecase "Xem\nthống kê" as ReportUC #F1F5F9
}

together {
    User -down- WalletUC
    User -down- TransactionUC
    User -down- CategoryUC
    User -down- BudgetUC
    User -down- ReportUC
}

legend bottom
  |= Mục tiêu chính |= Chức năng thuộc phạm vi |
  | Quản lý ví | Xem danh sách; tạo; cập nhật tên, số dư, tiền tệ; xóa ví. |
  | Quản lý giao dịch | Xem/thêm/sửa/xóa thu chi; lọc; recurring; backfill; dự phóng tương lai. |
  | Quản lý danh mục | Xem/tạo/sửa; gộp các category cùng TransactionType; xóa mềm. |
  | Quản lý ngân sách | Xem theo ví; tạo/sửa/xóa; tính đã chi, còn lại và tỷ lệ sử dụng. |
  | Xem thống kê | Dashboard; chọn khoảng thời gian; thu/chi/số dư; biểu đồ; phân bổ category. |
  | <b>Quy tắc</b> | Backfill + balance lưu nguyên tử; dự phóng không lưu DB và không đổi balance. |
  | <b>Ngoài UI hiện tại</b> | CsvStorage chưa nối JavaFX UI nên không có use case nhập/xuất CSV. |
endlegend

@enduml
