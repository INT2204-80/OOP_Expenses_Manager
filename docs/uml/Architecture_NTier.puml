@startuml Architecture_NTier
!pragma layout elk
allowmixing

skinparam backgroundColor #F8FAFC
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam roundCorner 12
skinparam nodesep 44
skinparam ranksep 52
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.25
skinparam TitleFontColor #0F172A
skinparam TitleFontSize 20
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #64748B
    FontColor #1E293B
    RoundCorner 12
}
skinparam database {
    BackgroundColor #FFF7ED
    BorderColor #EA580C
    FontColor #7C2D12
}
skinparam file {
    BackgroundColor #F0FDFA
    BorderColor #0F766E
    FontColor #134E4A
}
skinparam note {
    BackgroundColor #FFFBEB
    BorderColor #D97706
    FontColor #422006
}

title <b>OOP Expenses Manager</b>\n<size:13><color:#64748B>Kiến trúc phân tầng · Current implementation</color></size>
top to bottom direction

rectangle "<b>1 · PRESENTATION</b>\n<color:#64748B>expensemanager.ui</color>\n\n<b>Entry controllers</b>\nDashboardController · WalletViewController · BudgetsViewController\n\n<b>Wallet screen managers</b>\nTransaction · Category · Budget · Overview · Period filter\n\n<b>Factories & UI utilities</b>\nDialog · Card · Row · Filter · Chart · Format" as UI #F5F3FF

rectangle "<b>2 · APPLICATION</b>\n<color:#64748B>expensemanager.service</color>\n\nDashboardService · TransactionService\nCategoryService · BudgetService\nWalletOverviewCalculator\n\n<color:#9A3412>Điều phối use case · kiểm tra nghiệp vụ · giao dịch JDBC nguyên tử</color>" as APP #FFF7ED

rectangle "<b>3 · CORE</b>\n<color:#64748B>core · core.wallet · core.transaction · core.storage contracts</color>\n\n<b>DOMAIN MODEL</b>\nWallet hierarchy · Transaction hierarchy\nCategory · Budget · Period · enum\n\n──────────────\n\n<b>PERSISTENCE CONTRACTS</b>\nIWalletDAO · ITransactionDAO · ICategoryDAO · IBudgetDAO · Storage\n\n<color:#166534>Hai mối quan tâm ngang hàng trong cùng ranh giới core</color>" as CORE #F0FDF4

rectangle "<b>4 · PERSISTENCE IMPLEMENTATIONS</b>\n<color:#64748B>core.storage</color>\n\nWalletDAO · TransactionDAO · CategoryDAO · BudgetDAO\nDatabaseConnection\n\nCsvStorage" as PERSISTENCE #EFF6FF

rectangle " " as STORE_JOIN #475569
database "<b>MySQL</b>\nexpense_manager" as MYSQL
file "<b>CSV UTF-8</b>\n16 columns" as CSV

UI -down-> APP : gọi service
APP -down-> CORE : dùng domain & DAO contracts
PERSISTENCE -up-> CORE : hiện thực contracts & ánh xạ domain
PERSISTENCE -down- STORE_JOIN
together {
    STORE_JOIN -down-> MYSQL : JDBC
    STORE_JOIN -down-> CSV : save / load
}

legend bottom
  |= Luồng |= Ý nghĩa |
  | Presentation → Application | UI gọi các use case qua service. |
  | Application → Core | Service dùng domain model và persistence contracts. |
  | Persistence → Core | DAO hiện thực contract và ánh xạ dữ liệu thành domain object. |
  | Persistence → Data stores | JDBC với MySQL; CsvStorage đọc/ghi tệp CSV UTF-8. |
  | <b>Hiện trạng UI</b> | Controller khởi tạo concrete service/DAO; WalletViewController và BudgetsViewController còn dùng một số DAO contract trực tiếp. |
endlegend

@enduml
