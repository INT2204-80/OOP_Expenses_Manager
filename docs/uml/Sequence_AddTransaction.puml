@startuml Sequence_AddTransaction

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam maxMessageSize 55
skinparam sequence {
    ArrowColor #455A64
    LifeLineBorderColor #90A4AE
    LifeLineBackgroundColor #FAFAFA
    ParticipantBorderColor #607D8B
    ParticipantBackgroundColor #E3F2FD
    ActorBorderColor #E65100
    ActorBackgroundColor #FFF3E0
    GroupBackgroundColor #FAFAFA
    GroupBorderColor #B0BEC5
    ParticipantPadding 20
    BoxPadding 10
}
skinparam note {
    BackgroundColor #FFF8E1
    BorderColor #F9A825
}

title Sequence - Thêm giao dịch và cập nhật số dư nguyên tử
autonumber

actor "Người dùng" as User
boundary "WalletView\nController" as Controller
control "WalletTransaction\nManager" as Manager
boundary "Transaction dialog" as Dialog
control "Transaction\nService" as Service
entity "Wallet" as Wallet
participant "DAO layer\nTransactionDAO + WalletDAO" as DAO
database "MySQL" as DB

group Nhập giao dịch
    User -> Controller : Bấm "Thêm giao dịch"
    Controller -> Manager : showAddTransactionDialog(categories, wallet, callback)
    Manager -> Dialog : create và showAndWait()
    Dialog --> User : Hiển thị biểu mẫu
    User -> Dialog : Nhập dữ liệu, xác nhận
    Dialog --> Manager : Transaction t
end

alt Dữ liệu không hợp lệ
    Manager --> User : Hiển thị lỗi, không lưu
else Dữ liệu hợp lệ
    alt t là RecurringExpense có kỳ đã qua
        Manager --> User : Xác nhận backfill các kỳ đã qua
        alt Người dùng đồng ý
            Manager -> Service : addRecurringExpenseWithBackfill(re, wallet)
        else Người dùng hủy
            break Hủy thao tác
                Manager --> User : Kết thúc, không thay đổi dữ liệu
            end
        end
    else Giao dịch thường / recurring chưa quá hạn
        Manager -> Service : addTransactionAndUpdateWallet(t, wallet)
    end

    group Xử lý nghiệp vụ trong bộ nhớ
        Service -> Service : snapshot balance, transaction list và ID
        alt Income
            Service -> Wallet : deposit(amount)
        else Expense / RecurringExpense
            Service -> Wallet : withdraw(amount)
        end
        Service -> Wallet : addTransaction(t)
    end

    group Lưu DB trong cùng một JDBC transaction
        Service -> DAO : save transaction(s) và update balance
        DAO -> DB : BEGIN; INSERT transaction(s); UPDATE wallet
        DB --> DAO : generated ID / kết quả

        alt Tất cả thao tác thành công
            DAO -> DB : COMMIT
            DAO --> Service : success
            Service --> Manager : success
            Manager -> Controller : callback.run()
            Controller --> User : Làm mới danh sách và số dư
        else Thiếu số dư hoặc lỗi DAO / JDBC
            DAO -> DB : ROLLBACK (nếu đã bắt đầu)
            DAO --> Service : exception
            Service -> Service : khôi phục balance, list và ID cũ
            Service --> Manager : RuntimeException
            Manager --> User : Hiển thị thông báo lỗi
        end
    end
end

note over Service, Wallet
  Constructor Income / Expense / RecurringExpense chỉ tạo object.
  Chỉ TransactionService được cộng hoặc trừ số dư ví.
end note

note over DAO, DB
  TransactionDAO tự tra/tạo category bằng cùng Connection;
  WalletDAO cập nhật balance trước khi COMMIT.
end note

@enduml
