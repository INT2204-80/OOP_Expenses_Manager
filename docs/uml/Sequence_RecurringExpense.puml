@startuml Sequence_RecurringExpense

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam maxMessageSize 58
skinparam sequence {
    ArrowColor #455A64
    LifeLineBorderColor #90A4AE
    LifeLineBackgroundColor #FAFAFA
    ParticipantBorderColor #607D8B
    ParticipantBackgroundColor #E3F2FD
    ActorBorderColor #E65100
    ActorBackgroundColor #FFF3E0
    GroupBackgroundColor #FAFAFA
    GroupBorderColor #B0BEC5
    ParticipantPadding 20
}
skinparam note {
    BackgroundColor #FFF8E1
    BorderColor #F9A825
}

title Sequence - Xử lý chi tiêu định kỳ quá hạn
autonumber

actor "Người dùng" as User
boundary "WalletView\nController" as Controller
control "Transaction\nService" as Service
entity "Recurring\nExpense" as Recurring
entity "Wallet" as Wallet
participant "DAO layer\nTransactionDAO + WalletDAO" as DAO
database "MySQL" as DB

User -> Controller : Mở / làm mới màn hình ví
Controller -> Service : getTransactionsByWallet(wallet)

group Tải và xác định các kỳ đã qua
    Service -> DAO : getTransactionsByWallet(wallet)
    DAO -> DB : SELECT transactions + categories WHERE wallet_id = ?
    DB --> DAO : rows
    DAO --> Service : List<Transaction>
    Service -> Service : snapshot balance, wallet.transactions, passedPeriods

    loop Mỗi RecurringExpense re
        Service -> Recurring : oldPassed = getPassedPeriods()
        Service -> Recurring : nextDueDate()
        Recurring --> Service : cập nhật passedPeriods; trả kỳ kế tiếp

        alt passedPeriods tăng
            loop Mỗi kỳ mới bị quá hạn
                Service -> Service : Tạo Expense cho occurrenceDate
                Service -> Wallet : withdraw(amount)
                Service -> Service : newExpenses.add(expense)
            end
        end
    end
end

alt Không có kỳ mới
    Service --> Controller : List<Transaction> không đổi
else Có kỳ mới
    group Lưu toàn bộ thay đổi nguyên tử
        Service -> DAO : update recurring + save expenses + update balance
        DAO -> DB : BEGIN; UPDATE + INSERT + UPDATE wallet
        DB --> DAO : generated IDs / kết quả

        alt Thành công
            DAO -> DB : COMMIT
            DAO --> Service : success
            Service -> Service : transactions.addAll(newExpenses)
            Service --> Controller : List<Transaction> đã cập nhật
        else Thiếu số dư hoặc lỗi DAO / JDBC
            DAO -> DB : ROLLBACK (nếu đã bắt đầu)
            DAO --> Service : exception
            Service -> Recurring : khôi phục passedPeriods cũ
            Service -> Wallet : khôi phục balance và transaction list
            Service -> Service : bỏ các Expense vừa sinh
            Service --> Controller : RuntimeException
            Controller --> User : Hiển thị Alert lỗi
        end
    end
end

opt Thành công
    Controller -> Wallet : clear transactions; addAll(loadedTransactions)
    Controller --> User : Hiển thị giao dịch và số dư mới
end

note over Recurring, Wallet
  nextDueDate() tiến tới kỳ đầu tiên sau ngày tham chiếu
  và không vượt endDate. Mỗi kỳ đã qua chỉ được sinh một lần.
end note

note over Controller, DAO
  PendingRecurringOccurrence chỉ phục vụ dự phóng tương lai:
  không lưu DB và không trừ tiền trong ví.
end note

@enduml
