@startuml Sequence_BudgetManagement

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam maxMessageSize 55
skinparam sequence {
    ArrowColor #455A64
    LifeLineBorderColor #90A4AE
    LifeLineBackgroundColor #FAFAFA
    ParticipantBorderColor #607D8B
    ParticipantBackgroundColor #E3F2FD
    ActorBorderColor #E65100
    ActorBackgroundColor #FFF3E0
    GroupBackgroundColor #FAFAFA
    GroupBorderColor #B0BEC5
    ParticipantPadding 22
}
skinparam note {
    BackgroundColor #FFF8E1
    BorderColor #F9A825
}

title Sequence - Quản lý ngân sách
autonumber

actor "Người dùng" as User
boundary "WalletView\nController" as Controller
control "WalletBudget\nManager" as Manager
boundary "Budget dialog / card" as UI
control "BudgetService" as Service
participant "BudgetDAO\n(+ CategoryDAO)" as DAO
database "MySQL" as DB

alt Tạo ngân sách
    User -> Controller : Bấm "Tạo ngân sách"
    Controller -> Manager : handleShowAddBudgetDialog(categories, wallet, container)
    Manager -> UI : Mở add dialog
    UI --> User : Hiển thị biểu mẫu
    User -> UI : Nhập và xác nhận
    UI --> Manager : Budget mới
    Manager -> Service : addBudget(budget, walletId)
    Service -> DAO : addBudget(budget, walletId)
    DAO -> DB : Tra categoryId; INSERT budget
    DB --> DAO : generatedId
    DAO --> Service : Budget đã có ID

else Sửa ngân sách
    User -> Manager : Chọn "Sửa"
    Manager -> UI : Mở edit dialog(budget, categories)
    User -> UI : Sửa và xác nhận
    UI --> Manager : Budget đã cập nhật
    Manager -> Service : updateBudget(budget)
    Service -> DAO : updateBudget(budget)
    DAO -> DB : Tra categoryId; UPDATE budget

else Xóa ngân sách
    User -> Manager : Xác nhận xóa
    Manager -> Service : removeBudget(budgetId)
    Service -> DAO : deleteBudget(budgetId)
    DAO -> DB : DELETE budget
end

group Làm mới danh sách và tiến độ
    Manager -> Service : getBudgetsByWallet(walletId)
    Service -> DAO : getBudgetsByWallet(walletId)
    DAO -> DB : SELECT budgets + tra Category theo categoryId
    DB --> DAO : rows
    DAO --> Service : List<Budget>
    Service --> Manager : List<Budget>

    loop Mỗi Budget
        Manager -> Manager : budget.updateSpentFromTransactions(wallet.transactions)
        Manager -> UI : createBudgetCard(budget, callbacks)
    end
    Manager -> Controller : Cập nhật budgetsContainer
    Controller --> User : Hiển thị hạn mức, đã chi và còn lại
end

note over Manager, UI
  currentSpent được tính lại trong bộ nhớ để hiển thị:
  chỉ Expense cùng category và trong [startDate, endDate].
end note

@enduml
