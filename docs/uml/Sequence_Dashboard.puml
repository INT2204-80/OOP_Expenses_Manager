@startuml Sequence_Dashboard

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam maxMessageSize 60
skinparam sequence {
    ArrowColor #455A64
    LifeLineBorderColor #90A4AE
    LifeLineBackgroundColor #FAFAFA
    ParticipantBorderColor #607D8B
    ParticipantBackgroundColor #E3F2FD
    ActorBorderColor #E65100
    ActorBackgroundColor #FFF3E0
    GroupBackgroundColor #FAFAFA
    GroupBorderColor #B0BEC5
    ParticipantPadding 25
}

title Sequence - Tải Dashboard
autonumber

actor "Người dùng" as User
boundary "Dashboard\nController" as Controller
control "Dashboard\nService" as Service
participant "WalletDAO" as WalletDAO
participant "TransactionDAO" as TransactionDAO
database "MySQL" as DB

User -> Controller : Mở Dashboard
Controller -> Controller : initialize()

group 1. Tải ví và tổng số dư
    Controller -> Service : getOrInitWallets()
    Service -> WalletDAO : getAllWallets()
    WalletDAO -> DB : SELECT wallets
    DB --> WalletDAO : wallet rows
    WalletDAO --> Service : List<Wallet>

    alt Chưa có ví
        Service -> Service : Tạo CashWallet("Ví tiền mặt", 0)
        Service -> WalletDAO : addWallet(defaultWallet)
        WalletDAO -> DB : INSERT wallet
        Service -> WalletDAO : getAllWallets()
        WalletDAO -> DB : SELECT wallets
        DB --> WalletDAO : wallet rows
        WalletDAO --> Service : List<Wallet>
    end

    Service --> Controller : List<Wallet>
    Controller -> Service : calculateTotalBalance(wallets)
    Service --> Controller : totalBalance
    Controller -> Controller : Render wallet cards + tổng số dư
end

group 2. Tải tổng quan theo khoảng thời gian
    Controller -> Service : getOverviewData(startDate, endDate)

    Service -> TransactionDAO : getTotalAmountForPeriod("INCOME", start, end)
    TransactionDAO -> DB : SUM(amount) WHERE transaction_type = INCOME\nAND date BETWEEN start AND end
    DB --> TransactionDAO : totalIncome

    Service -> TransactionDAO : getTotalAmountForPeriod("EXPENSE", start, end)
    TransactionDAO -> DB : SUM(amount) WHERE transaction_type = EXPENSE\nAND date BETWEEN start AND end
    DB --> TransactionDAO : totalExpense

    TransactionDAO --> Service : totals
    Service --> Controller : OverviewData(income, expense, netChange)
    Controller -> Controller : Cập nhật nhãn thu, chi, dòng tiền
end

Controller --> User : Dashboard hoàn chỉnh

note over Service, TransactionDAO
  netChange = income - expense.
  Khoảng ngày được tính bao gồm cả startDate và endDate.
end note

@enduml
