<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.StackedBarChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="dashboard-container" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="expensemanager.ui.controllers.WalletViewController">
    
    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="CENTER" spacing="20" styleClass="top-bar">
            <!-- Logo area (Clickable to go back) -->
            <HBox alignment="CENTER_LEFT" onMouseClicked="#handleBackToDashboard" spacing="8" style="-fx-cursor: hand; -fx-padding: 0 0 0 10;">
                <ImageView fitHeight="45" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                    <effect>
                        <ColorAdjust brightness="-0.8" />
                    </effect>
                </ImageView>
                <Label style="-fx-text-fill: #a0aec0; -fx-font-weight: bold;" text="&gt;" />
                <Label fx:id="walletNameTopLabel" styleClass="logo-text" text="Ví tiền mặt" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Center Menu -->
            <HBox alignment="CENTER" spacing="30">
                <VBox fx:id="menuTransactions" alignment="CENTER" onMouseClicked="#switchToTransactions" styleClass="nav-item-active-container">
                    <Label styleClass="nav-item" text="Transactions" />
                </VBox>
                <VBox fx:id="menuOverview" alignment="CENTER" onMouseClicked="#switchToOverview" styleClass="nav-item-container">
                    <Label styleClass="nav-item" text="Overview" />
                </VBox>
                <VBox fx:id="menuBudgets" alignment="CENTER" onMouseClicked="#switchToBudgets" styleClass="nav-item-container">
                    <Label styleClass="nav-item" text="Budgets" />
                </VBox>
                <VBox fx:id="menuSettings" alignment="CENTER" onMouseClicked="#switchToSettings" styleClass="nav-item-container">
                    <Label styleClass="nav-item" text="Wallet Settings" />
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <StackPane>
                <!-- TRANSACTIONS TAB -->
                <VBox fx:id="tabTransactions" spacing="30" styleClass="content-area">
                    <padding>
                        <Insets bottom="30" left="60" right="60" top="30" />
                    </padding>
                    
                    <!-- ACTION BAR SECTION -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Button onAction="#showAddTransactionDialog" styleClass="solid-button" text="+ Add transaction" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="futureToggleButton" onAction="#handleFutureToggle" styleClass="toggle-button" text="Future" />
                        <!-- Date Range Selector -->
                        <HBox alignment="CENTER" spacing="10" styleClass="date-selector">
                            <Button onAction="#handlePrevPeriod" styleClass="date-btn" text="&lt;" />
                            <HBox alignment="CENTER" onMouseClicked="#handleCustomPeriod" spacing="5" style="-fx-cursor: hand;">
                                <Label fx:id="periodLabelTrans" style="-fx-cursor: hand;" styleClass="date-text" text="Aug 01, 2026 - Aug 31, 2026" />
                                <SVGPath content="M19,4h-1V2h-2v2H8V2H6v2H5C3.89,4,3.01,4.9,3.01,6L3,20c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V6C21,4.9,20.1,4,19,4z M19,20H5V10h14V20z M19,8H5V6h14V8z" fill="#a0aec0" scaleX="0.65" scaleY="0.65" />
                            </HBox>
                            <Button onAction="#handleNextPeriod" styleClass="date-btn" text="&gt;" />
                        </HBox>
                    </HBox>

                    <!-- 4 Summary Cards -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Current Wallet Balance" />
                            <Label fx:id="currentBalanceLabel" styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Change" />
                            <Label styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Expenses" />
                            <Label styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Income" />
                            <Label styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>
                    </HBox>
                    <!-- TRANSACTIONS LIST -->
                    <javafx.scene.control.ScrollPane fx:id="transactionsScrollPane" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent;" visible="false" VBox.vgrow="ALWAYS">
                        <VBox fx:id="transactionsListContainer" spacing="10">
                            <!-- Transactions will be added here dynamically -->
                        </VBox>
                    </javafx.scene.control.ScrollPane>

                    <!-- EMPTY STATE (Wallet with flying money) -->
                    <VBox fx:id="emptyTransactionsState" alignment="CENTER" spacing="20" styleClass="empty-state-area" VBox.vgrow="ALWAYS">
                        <StackPane>
                            <!-- Background money bill flying -->
                            <SVGPath content="M4 6h16v12H4z" fill="white" rotate="-30" stroke="#e2e8f0" strokeWidth="2" translateX="30" translateY="-20" />
                            <Circle fill="#cbd5e0" radius="3" translateX="30" translateY="-20" />
                            <SVGPath content="M2 12s3-3 8-3 8 3 8 3" fill="transparent" rotate="-20" stroke="#e2e8f0" strokeDashArray="2" strokeWidth="1" translateX="50" translateY="-30" />
                            <!-- Main Wallet -->
                            <SVGPath content="M21 7.28V5c0-1.1-.9-2-2-2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-2.28A2 2 0 0 0 22 15V9a2 2 0 0 0-1-1.72zM20 9v6h-7V9h7zM5 19V5h14v2h-6c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h6v2H5z" fill="white" scaleX="3.5" scaleY="3.5" stroke="#e2e8f0" strokeWidth="1.5" />
                        </StackPane>
                        <Label styleClass="empty-state-text" text="You have no transactions.">
                            <padding><Insets top="30" /></padding>
                        </Label>
                    </VBox>
                </VBox>

                <!-- OVERVIEW TAB -->
                <VBox fx:id="tabOverview" spacing="30" styleClass="content-area" visible="false">
                    <padding>
                        <Insets bottom="30" left="60" right="60" top="30" />
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Button onAction="#showAddTransactionDialog" styleClass="solid-button" text="+ Add transaction" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10" styleClass="date-selector">
                            <Button onAction="#handlePrevPeriod" styleClass="date-btn" text="&lt;" />
                            <HBox alignment="CENTER" onMouseClicked="#handleCustomPeriod" spacing="5" style="-fx-cursor: hand;">
                                <Label fx:id="periodLabelOverview" style="-fx-cursor: hand;" styleClass="date-text" text="Aug 01, 2026 - Aug 31, 2026" />
                                <SVGPath content="M19,4h-1V2h-2v2H8V2H6v2H5C3.89,4,3.01,4.9,3.01,6L3,20c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V6C21,4.9,20.1,4,19,4z M19,20H5V10h14V20z M19,8H5V6h14V8z" fill="#a0aec0" scaleX="0.65" scaleY="0.65" />
                            </HBox>
                            <Button onAction="#handleNextPeriod" styleClass="date-btn" text="&gt;" />
                        </HBox>
                    </HBox>

                    <!-- Filters Section -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="filters-title" text="Filters" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="resetFiltersLabel" onMouseClicked="#handleResetFilters" styleClass="filters-reset" text="Reset filters" />
                        </HBox>
                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="settings-field-label" text="By category" />
                                <javafx.scene.control.ComboBox fx:id="filterCategoryCombo" maxWidth="Infinity" promptText="All categories" styleClass="filter-box" />
                            </VBox>
                            
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="settings-field-label" text="By note" />
                                <javafx.scene.control.TextField fx:id="filterNoteField" promptText="Filter by specific keyword" styleClass="filter-box" />
                            </VBox>
                            
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="settings-field-label" text="By amount" />
                                <HBox spacing="10">
                                    <javafx.scene.control.TextField fx:id="filterMinAmountField" promptText="Min (VND)" styleClass="filter-box" HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-text-fill: #a0aec0; -fx-padding: 5 0 0 0;" text="-" />
                                    <javafx.scene.control.TextField fx:id="filterMaxAmountField" promptText="Max (VND)" styleClass="filter-box" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- 4 Summary Cards -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Current Wallet Balance" />
                            <Label fx:id="overviewBalanceLabel" styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Change" />
                            <Label fx:id="overviewChangeLabel" styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Expenses" />
                            <Label fx:id="overviewExpenseLabel" style="-fx-text-fill: #ef4444;" styleClass="summary-card-value" text="0.00 VND" />
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="summary-card-title" text="Total Period Income" />
                            <Label fx:id="overviewIncomeLabel" styleClass="summary-card-value, value-spendee-green" text="0.00 VND" />
                        </VBox>
                    </HBox>

                    <!-- CHARTS ROW 1: Account Balance & Changes -->
                    <HBox spacing="20">
                        <!-- Account Balance -->
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <VBox>
                                    <Label styleClass="chart-title" text="Account Balance" />
                                    <Label styleClass="chart-subtitle" text="Aug 01-31" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox styleClass="chart-toggles">
                                    <Label fx:id="balDaysLbl" onMouseClicked="#handleBalDays" styleClass="chart-toggle-active" text="Days" />
                                    <Label fx:id="balWeeksLbl" onMouseClicked="#handleBalWeeks" styleClass="chart-toggle" text="Weeks" />
                                    <Label fx:id="balMonthsLbl" onMouseClicked="#handleBalMonths" styleClass="chart-toggle" text="Months" />
                                </HBox>
                            </HBox>
                            <javafx.scene.chart.AreaChart fx:id="balanceChart" createSymbols="true" legendVisible="false" prefHeight="250">
                                <xAxis><javafx.scene.chart.CategoryAxis /></xAxis>
                                <yAxis><javafx.scene.chart.NumberAxis autoRanging="true" /></yAxis>
                            </javafx.scene.chart.AreaChart>
                        </VBox>
                        
                        <!-- Changes -->
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <VBox>
                                    <Label styleClass="chart-title" text="Changes" />
                                    <Label styleClass="chart-subtitle" text="Aug 01-31" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox styleClass="chart-toggles">
                                    <Label fx:id="chgDaysLbl" onMouseClicked="#handleChgDays" styleClass="chart-toggle-active" text="Days" />
                                    <Label fx:id="chgWeeksLbl" onMouseClicked="#handleChgWeeks" styleClass="chart-toggle" text="Weeks" />
                                    <Label fx:id="chgMonthsLbl" onMouseClicked="#handleChgMonths" styleClass="chart-toggle" text="Months" />
                                </HBox>
                            </HBox>
                            <javafx.scene.chart.StackedBarChart fx:id="changesChart" categoryGap="8" legendVisible="false" prefHeight="250">
                                <xAxis><javafx.scene.chart.CategoryAxis animated="false" tickLabelsVisible="false" tickMarkVisible="false" /></xAxis>
                                <yAxis><javafx.scene.chart.NumberAxis animated="false" side="LEFT" style="-fx-tick-label-font-size: 9px;" tickLabelFill="#94a3b8" /></yAxis>
                            </javafx.scene.chart.StackedBarChart>
                        </VBox>
                    </HBox>

                    <!-- CHARTS ROW 2: Period Income & Period Expenses -->
                    <HBox spacing="20">
                        <!-- Period Income -->
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                            <VBox>
                                <Label styleClass="chart-title" text="Period Income" />
                                <Label styleClass="chart-subtitle" text="Aug 01-31" />
                            </VBox>
                            
                            <StackPane prefHeight="250">
                                <javafx.scene.chart.PieChart fx:id="incomePieChart" labelsVisible="false" legendVisible="false" />
                                <Circle fill="white" radius="60" />
                            </StackPane>
                            <VBox fx:id="incomeLegendBox" spacing="10" style="-fx-padding: 10 0 0 0;" />
                        </VBox>
                        
                        <!-- Period Expenses -->
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                            <VBox>
                                <Label styleClass="chart-title" text="Period Expenses" />
                                <Label styleClass="chart-subtitle" text="Aug 01-31" />
                            </VBox>
                            
                            <StackPane prefHeight="250">
                                <javafx.scene.chart.PieChart fx:id="expensePieChart" labelsVisible="false" legendVisible="false" />
                                <Circle fill="white" radius="60" />
                            </StackPane>
                            <VBox fx:id="expenseLegendBox" spacing="10" style="-fx-padding: 10 0 0 0;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- BUDGETS TAB -->
                <VBox fx:id="tabBudgets" spacing="30" styleClass="content-area" visible="false">
                    <padding>
                        <Insets bottom="30" left="60" right="60" top="30" />
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Ngân sách (Budgets)" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleShowAddBudgetDialog" styleClass="solid-button" text="Create a New Budget" />
                    </HBox>
                    
                    <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="budgetsContainer" spacing="20" style="-fx-background-color: transparent;">
                            <VBox alignment="CENTER" spacing="15" styleClass="budget-empty-box">
                                <Label styleClass="budget-text" text="Take control of your expenses and" />
                                <Label styleClass="budget-text" text="save more money with budgets!" />
                                <Button onAction="#handleShowAddBudgetDialog" styleClass="solid-button" text="Create a New Budget">
                                    <VBox.margin><Insets top="10" /></VBox.margin>
                                </Button>
                            </VBox>
                        </VBox>
                    </javafx.scene.control.ScrollPane>
                </VBox>

                <!-- SETTINGS TAB -->
                <HBox fx:id="tabSettings" visible="false">
                    <!-- Left Sidebar -->
                    <VBox prefWidth="250" spacing="15" styleClass="settings-sidebar">
                        <padding><Insets left="40" top="30" /></padding>
                        <Label fx:id="menuSettingsMain" onMouseClicked="#switchToSettingsMain" styleClass="settings-menu-item, settings-menu-item-active" text="Main Settings" />
                        <Label fx:id="menuSettingsCat" onMouseClicked="#switchToSettingsCat" styleClass="settings-menu-item" text="Categories Settings" />
                    </VBox>

                    <!-- Right Content -->
                    <StackPane styleClass="settings-content-area" HBox.hgrow="ALWAYS">
                        
                        <!-- Main Settings Content -->
                        <VBox fx:id="settingsMain" spacing="30" styleClass="settings-panel">
                            <padding><Insets bottom="30" left="40" right="60" top="40" /></padding>
                            
                            <Label styleClass="settings-section-title" text="General information" />
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-field-label" text="Wallet Name" />
                                    <javafx.scene.control.TextField fx:id="settingWalletName" styleClass="settings-textfield" />
                                </VBox>
                            </HBox>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-field-label" text="Initial balance" />
                                    <!-- BỔ SUNG: fx:id="settingInitialBalance" -->
                                    <javafx.scene.control.TextField fx:id="settingInitialBalance" styleClass="settings-textfield" text="0" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-field-label" text="Wallet currency" />
                                    <!-- BỔ SUNG: fx:id="settingCurrency" (để tránh bị lỗi NullPointerException tiếp theo) -->
                                    <javafx.scene.control.TextField fx:id="settingCurrency" styleClass="settings-textfield" text="VND" />
                                </VBox>
                            </HBox>
                            
                            <HBox alignment="CENTER_LEFT">
                                <Button onAction="#handleUpdateWalletSettings" 
                                        style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-cursor: hand;" 
                                        styleClass="toggle-button" 
                                        text="Update settings" />
                            </HBox>


                            <HBox alignment="CENTER_RIGHT">
                                <Label onMouseClicked="#handleDeleteWallet" 
                                       style="-fx-text-fill: #ef4444; -fx-underline: true; -fx-cursor: hand;" 
                                       text="Delete wallet" />
                            </HBox>
                        </VBox>

                        <!-- Categories Settings Content -->
                        <VBox fx:id="settingsCategories" spacing="30" styleClass="settings-panel" visible="false">
                            <padding><Insets bottom="30" left="40" right="60" top="40" /></padding>
                            
                            <Label styleClass="settings-section-title" text="Create a new category" />
                            <HBox alignment="BOTTOM_LEFT" spacing="15">
                                <VBox spacing="5">
                                    <Label styleClass="settings-field-label" text="Icon" />
                                    <javafx.scene.control.ComboBox fx:id="categoryIconCombo" prefWidth="100" styleClass="settings-combo" />
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="settings-field-label" text="Color" />
                                    <javafx.scene.control.ComboBox fx:id="categoryColorCombo" prefWidth="100" styleClass="settings-combo" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-field-label" text="Name" />
                                    <javafx.scene.control.TextField fx:id="newCategoryNameField" promptText="New category name" styleClass="settings-textfield" />
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="settings-field-label" text="Type" />
                                    <javafx.scene.control.ComboBox fx:id="categoryTypeCombo" prefWidth="120" promptText="Expense" styleClass="settings-combo" />
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="" /> <!-- Spacer for alignment -->
                                    <Button onAction="#handleCreateCategory" style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 4; -fx-cursor: hand;" styleClass="create-category-btn" text="Create category" />
                                </VBox>
                            </HBox>

                            <Region prefHeight="10" />
                            <Label styleClass="settings-section-title" text="Manage categories" />
                            <HBox spacing="10">
                                <Button onAction="#handleMergeCategories" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;" styleClass="toggle-button" text="Merge categories" />
                                <Button onAction="#handleDeleteCategories" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;" styleClass="toggle-button" text="Delete categories" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Income categories" />
                            <VBox fx:id="incomeCategoriesContainer" spacing="10">
                                <!-- Dynamic Items -->
                            </VBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Expense categories" />
                            <VBox fx:id="expenseCategoriesContainer" spacing="10">
                                <!-- Dynamic Items -->
                            </VBox>
                        </VBox>
                    </StackPane>
                </HBox>
            </StackPane>
        </javafx.scene.control.ScrollPane>
    </center>

    <!-- FLOATING HELP BUTTON -->
    <bottom>
        <HBox alignment="BOTTOM_RIGHT" pickOnBounds="false">
            <padding>
                <Insets bottom="30" right="30" />
            </padding>

        </HBox>
    </bottom>

</BorderPane>
