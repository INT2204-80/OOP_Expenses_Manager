<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="expensemanager.ui.WalletViewController"
            styleClass="dashboard-container" stylesheets="@../css/dashboard.css">
    
    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER" spacing="20">
            <!-- Logo area (Clickable to go back) -->
            <HBox alignment="CENTER_LEFT" spacing="8" onMouseClicked="#handleBackToDashboard" style="-fx-cursor: hand;">
                <StackPane>
                    <Circle radius="12" styleClass="logo-circle"/>
                    <Label text="S" styleClass="logo-s-text"/>
                </StackPane>
                <Label text="&gt;" style="-fx-text-fill: #a0aec0; -fx-font-weight: bold;"/>
                <Label fx:id="walletNameTopLabel" text="Ví tiền mặt" styleClass="logo-text"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Center Menu -->
            <HBox alignment="CENTER" spacing="30">
                <VBox fx:id="menuTransactions" alignment="CENTER" styleClass="nav-item-active-container" onMouseClicked="#switchToTransactions">
                    <Label text="Transactions" styleClass="nav-item"/>
                </VBox>
                <VBox fx:id="menuOverview" alignment="CENTER" styleClass="nav-item-container" onMouseClicked="#switchToOverview">
                    <Label text="Overview" styleClass="nav-item"/>
                </VBox>
                <VBox fx:id="menuBudgets" alignment="CENTER" styleClass="nav-item-container" onMouseClicked="#switchToBudgets">
                    <Label text="Budgets" styleClass="nav-item"/>
                </VBox>
                <VBox fx:id="menuSettings" alignment="CENTER" styleClass="nav-item-container" onMouseClicked="#switchToSettings">
                    <Label text="Wallet Settings" styleClass="nav-item"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Profile area -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <StackPane>
                    <Circle radius="16" fill="#e2e8f0"/>
                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#a0aec0" scaleX="0.8" scaleY="0.8"/>
                </StackPane>
                <Label text="Admin" styleClass="profile-name"/>
            </HBox>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <StackPane>
                <!-- TRANSACTIONS TAB -->
                <VBox fx:id="tabTransactions" spacing="30" styleClass="content-area">
                    <padding>
                        <Insets top="30" right="60" bottom="30" left="60"/>
                    </padding>
                    
                    <!-- ACTION BAR SECTION -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Button text="+ Add transaction" styleClass="solid-button" onAction="#showAddTransactionDialog"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Future" styleClass="toggle-button"/>
                        <Button text="Import" styleClass="toggle-button"/>
                        <!-- Date Range Selector -->
                        <HBox styleClass="date-selector" alignment="CENTER" spacing="10">
                            <Button text="&lt;" styleClass="date-btn"/>
                            <Label text="Aug 01, 2026 - Aug 31, 2026" styleClass="date-text"/>
                            <SVGPath content="M19,4h-1V2h-2v2H8V2H6v2H5C3.89,4,3.01,4.9,3.01,6L3,20c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V6C21,4.9,20.1,4,19,4z M19,20H5V10h14V20z M19,8H5V6h14V8z" fill="#a0aec0" scaleX="0.65" scaleY="0.65"/>
                            <Button text="&gt;" styleClass="date-btn"/>
                        </HBox>
                    </HBox>

                    <!-- 4 Summary Cards -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Current Wallet Balance" styleClass="summary-card-title"/>
                            <Label fx:id="currentBalanceLabel" text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Change" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Expenses" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Income" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>
                    </HBox>
                    <!-- EMPTY STATE (Wallet with flying money) -->
                    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="20" styleClass="empty-state-area">
                        <StackPane>
                            <!-- Background money bill flying -->
                            <SVGPath content="M4 6h16v12H4z" fill="white" stroke="#e2e8f0" strokeWidth="2" rotate="-30" translateX="30" translateY="-20"/>
                            <Circle radius="3" fill="#cbd5e0" translateX="30" translateY="-20"/>
                            <SVGPath content="M2 12s3-3 8-3 8 3 8 3" stroke="#e2e8f0" strokeWidth="1" strokeDashArray="2" fill="transparent" translateX="50" translateY="-30" rotate="-20"/>
                            <!-- Main Wallet -->
                            <SVGPath content="M21 7.28V5c0-1.1-.9-2-2-2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-2.28A2 2 0 0 0 22 15V9a2 2 0 0 0-1-1.72zM20 9v6h-7V9h7zM5 19V5h14v2h-6c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h6v2H5z" fill="white" stroke="#e2e8f0" strokeWidth="1.5" scaleX="3.5" scaleY="3.5"/>
                        </StackPane>
                        <Label text="You have no transactions." styleClass="empty-state-text">
                            <padding><Insets top="30"/></padding>
                        </Label>
                    </VBox>
                </VBox>

                <!-- OVERVIEW TAB -->
                <VBox fx:id="tabOverview" spacing="30" styleClass="content-area" visible="false">
                    <padding>
                        <Insets top="30" right="60" bottom="30" left="60"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Button text="+ Add transaction" styleClass="solid-button" onAction="#showAddTransactionDialog"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- Date Range Selector -->
                        <HBox styleClass="date-selector" alignment="CENTER" spacing="10">
                            <Button text="&lt;" styleClass="date-btn"/>
                            <Label text="Aug 01, 2026 - Aug 31, 2026" styleClass="date-text"/>
                            <SVGPath content="M19,4h-1V2h-2v2H8V2H6v2H5C3.89,4,3.01,4.9,3.01,6L3,20c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V6C21,4.9,20.1,4,19,4z M19,20H5V10h14V20z M19,8H5V6h14V8z" fill="#a0aec0" scaleX="0.65" scaleY="0.65"/>
                            <Button text="&gt;" styleClass="date-btn"/>
                        </HBox>
                    </HBox>

                    <!-- 4 Summary Cards -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Current Wallet Balance" styleClass="summary-card-title"/>
                            <Label fx:id="overviewBalanceLabel" text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Change" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Expenses" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>

                        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Period Income" styleClass="summary-card-title"/>
                            <Label text="0.00 VND" styleClass="summary-card-value, value-spendee-green"/>
                        </VBox>
                    </HBox>

                    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="20" styleClass="empty-state-area">
                        <!-- Chart / Document Icon -->
                        <StackPane>
                            <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="white" stroke="#e2e8f0" strokeWidth="1" scaleX="3.5" scaleY="3.5" rotate="-15" translateX="-20" translateY="10"/>
                            <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm-1 8.5c2.5 0 4.5 2 4.5 4.5s-2 4.5-4.5 4.5-4.5-2-4.5-4.5 2-4.5 4.5-4.5zm0 2c-1.38 0-2.5 1.12-2.5 2.5s1.12 2.5 2.5 2.5 2.5-1.12 2.5-2.5-1.12-2.5-2.5-2.5z" fill="white" stroke="#cbd5e0" strokeWidth="1" scaleX="3.5" scaleY="3.5" rotate="10" translateX="10" translateY="-10"/>
                        </StackPane>
                        <Label text="You have no transactions." styleClass="empty-state-text">
                            <padding><Insets top="30"/></padding>
                        </Label>
                    </VBox>
                </VBox>

                <!-- BUDGETS TAB -->
                <VBox fx:id="tabBudgets" spacing="30" styleClass="content-area" visible="false">
                    <padding>
                        <Insets top="30" right="60" bottom="30" left="60"/>
                    </padding>
                    
                    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="20">
                        <VBox alignment="CENTER" spacing="15" styleClass="budget-empty-box">
                            <Label text="Take control of your expenses and" styleClass="budget-text"/>
                            <Label text="save more money with budgets!" styleClass="budget-text"/>
                            <Button text="Create a New Budget" styleClass="solid-button">
                                <VBox.margin><Insets top="10"/></VBox.margin>
                            </Button>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- SETTINGS TAB -->
                <HBox fx:id="tabSettings" visible="false">
                    <!-- Left Sidebar -->
                    <VBox styleClass="settings-sidebar" prefWidth="250" spacing="15">
                        <padding><Insets top="30" left="40"/></padding>
                        <Label fx:id="menuSettingsMain" text="Main Settings" styleClass="settings-menu-item, settings-menu-item-active" onMouseClicked="#switchToSettingsMain"/>
                        <Label fx:id="menuSettingsCat" text="Categories Settings" styleClass="settings-menu-item" onMouseClicked="#switchToSettingsCat"/>
                    </VBox>

                    <!-- Right Content -->
                    <StackPane HBox.hgrow="ALWAYS" styleClass="settings-content-area">
                        
                        <!-- Main Settings Content -->
                        <VBox fx:id="settingsMain" spacing="30" styleClass="settings-panel">
                            <padding><Insets top="40" right="60" bottom="30" left="40"/></padding>
                            
                            <Label text="General information" styleClass="settings-section-title"/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Wallet Name" styleClass="settings-field-label"/>
                                    <javafx.scene.control.TextField fx:id="settingWalletName" styleClass="settings-textfield"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Initial balance" styleClass="settings-field-label"/>
                                    <javafx.scene.control.TextField text="0" styleClass="settings-textfield"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Wallet currency" styleClass="settings-field-label"/>
                                    <javafx.scene.control.TextField text="VND" styleClass="settings-textfield"/>
                                </VBox>
                            </HBox>
                            
                            <HBox alignment="CENTER_LEFT">
                                <Button text="Update settings" styleClass="toggle-button" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;"/>
                            </HBox>

                            <Region prefHeight="20"/>
                            <Label text="Wallet members" styleClass="settings-section-title"/>
                            <VBox spacing="5">
                                <Label text="Add new member" styleClass="settings-field-label"/>
                                <javafx.scene.control.TextField promptText="Invitee's email address" styleClass="settings-textfield"/>
                            </VBox>
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane>
                                    <Circle radius="16" fill="#e2e8f0"/>
                                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#a0aec0" scaleX="0.8" scaleY="0.8"/>
                                </StackPane>
                                <VBox>
                                    <Label text="Admin" style="-fx-font-weight: bold;"/>
                                    <Label text="admin@example.com" style="-fx-text-fill: #a0aec0; -fx-font-size: 12px;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Owner" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-padding: 2 6; -fx-background-radius: 4; -fx-font-size: 11px;"/>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT">
                                <Label text="Delete wallet" style="-fx-text-fill: #ef4444; -fx-underline: true; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- Categories Settings Content -->
                        <VBox fx:id="settingsCategories" spacing="30" styleClass="settings-panel" visible="false">
                            <padding><Insets top="40" right="60" bottom="30" left="40"/></padding>
                            
                            <Label text="Create a new category" styleClass="settings-section-title"/>
                            <HBox spacing="15" alignment="BOTTOM_LEFT">
                                <VBox spacing="5">
                                    <Label text="Icon" styleClass="settings-field-label"/>
                                    <javafx.scene.control.ComboBox styleClass="settings-combo" prefWidth="60"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Color" styleClass="settings-field-label"/>
                                    <javafx.scene.control.ComboBox styleClass="settings-combo" prefWidth="60"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Name" styleClass="settings-field-label"/>
                                    <javafx.scene.control.TextField promptText="New category name" styleClass="settings-textfield"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Type" styleClass="settings-field-label"/>
                                    <javafx.scene.control.ComboBox fx:id="categoryTypeCombo" styleClass="settings-combo" prefWidth="120" promptText="Expense"/>
                                </VBox>
                            </HBox>

                            <Region prefHeight="10"/>
                            <Label text="Manage categories" styleClass="settings-section-title"/>
                            <HBox spacing="10">
                                <Button text="Merge categories" styleClass="toggle-button" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;"/>
                                <Button text="Delete categories" styleClass="toggle-button" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;"/>
                            </HBox>

                            <Label text="Income categories" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                            <VBox spacing="10">
                                <!-- Mock Items -->
                                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="category-list-item">
                                    <Circle radius="12" fill="#4ade80"/>
                                    <Label text="Lương" styleClass="category-list-name"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="0 transactions" styleClass="category-list-count"/>
                                    <Label text="⚙" styleClass="category-list-action"/>
                                    <Label text="🗑" styleClass="category-list-action-danger"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="category-list-item">
                                    <Circle radius="12" fill="#facc15"/>
                                    <Label text="Kinh doanh" styleClass="category-list-name"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="0 transactions" styleClass="category-list-count"/>
                                    <Label text="⚙" styleClass="category-list-action"/>
                                    <Label text="🗑" styleClass="category-list-action-danger"/>
                                </HBox>
                            </VBox>

                            <Label text="Expense categories" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                            <VBox spacing="10">
                                <!-- Mock Items -->
                                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="category-list-item">
                                    <Circle radius="12" fill="#fb923c"/>
                                    <Label text="Đồ ăn &amp; Đồ uống" styleClass="category-list-name"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="0 transactions" styleClass="category-list-count"/>
                                    <Label text="⚙" styleClass="category-list-action"/>
                                    <Label text="🗑" styleClass="category-list-action-danger"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="category-list-item">
                                    <Circle radius="12" fill="#f472b6"/>
                                    <Label text="Mua sắm" styleClass="category-list-name"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="0 transactions" styleClass="category-list-count"/>
                                    <Label text="⚙" styleClass="category-list-action"/>
                                    <Label text="🗑" styleClass="category-list-action-danger"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </StackPane>
                </HBox>
            </StackPane>
        </javafx.scene.control.ScrollPane>
    </center>

    <!-- FLOATING HELP BUTTON -->
    <bottom>
        <HBox alignment="BOTTOM_RIGHT" pickOnBounds="false">
            <padding>
                <Insets right="30" bottom="30"/>
            </padding>
            <Button text="(?) Trợ giúp" styleClass="fab-help"/>
        </HBox>
    </bottom>

</BorderPane>
